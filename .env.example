# Ziel-Repository
# Ohne Angabe wird der aktuell geöffnete Ordner verwendet.
TERRACONTROL_REPOSITORY=

# Logging: debug, info, warn oder error
TERRACONTROL_LOG_LEVEL=info

# Ausschließlich lokale Ollama-Adresse verwenden.
TERRACONTROL_OLLAMA_URL=http://127.0.0.1:11434

# Kostenloses lokal installiertes Modell
TERRACONTROL_OLLAMA_MODEL=qwen2.5-coder:7b

# Zehn Minuten pro Modellaufruf
TERRACONTROL_OLLAMA_TIMEOUT_MS=600000

# Für den vorhandenen PC begrenztes Kontextfenster
TERRACONTROL_OLLAMA_CONTEXT=4096
